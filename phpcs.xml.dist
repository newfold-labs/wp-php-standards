<?xml version="1.0"?>
<ruleset name="wp-php-standards">
	<description>Lints this repository with the standard it ships.</description>

	<rule ref="Newfold"/>

	<file>Newfold</file>
	<file>tests</file>

	<!--
		Fixtures are deliberately written to violate the sniffs under test, so
		linting them reports the violations the tests exist to assert on.
	-->
	<exclude-pattern>tests/fixtures/*</exclude-pattern>

	<!--
		Sniffs read properties off PHP_CodeSniffer and PHPCSUtils classes, which
		name them in camelCase. They are third-party API and cannot be renamed, so
		they are allowed by name rather than by switching the sniff off.
	-->
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<properties>
			<property name="allowed_custom_properties" type="array">
				<element value="emptyTokens"/>
			</property>
		</properties>
	</rule>
</ruleset>
