<?xml version="1.0"?>
<ruleset name="Newfold">
    <description>The Newfold PHP Code Sniffer standard.</description>

    <arg name="colors"/>

    <!--
        The supported PHP version range. The floor is the minimum in the support matrix,
        which is the minimum WordPress itself supports, and the same floor this repository
        runs its own tests against.
    -->
    <config name="testVersion" value="7.4-"/>

    <!--
        The minimum supported WP version, which decides how far back WordPress deprecations
        are reported. 6.6 is what every brand plugin declares in its "Requires at least"
        header. The support matrix asks for the last three majors, which reads higher, so a
        repository that has moved past 6.6 should say so in its own ruleset.
    -->
    <config name="minimum_supported_wp_version" value="6.6"/>

    <!-- For CI, don't fail on warnings -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <exclude-pattern>*/phpunit.xml*</exclude-pattern>
    <exclude-pattern>*/languages/*</exclude-pattern>

    <exclude-pattern>*/tests/_data/*</exclude-pattern>
    <exclude-pattern>*/tests/_output/*</exclude-pattern>
    <exclude-pattern>*/tests/_support/*</exclude-pattern>

    <!-- Third-party code -->
    <exclude-pattern>*/bower-components/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <!-- Ensure certain file types aren't sniffed -->
    <exclude-pattern>*.js</exclude-pattern>
    <exclude-pattern>*.css</exclude-pattern>

    <!-- Don't worry about files that don't contain any code -->
    <rule ref="Internal.NoCodeFound">
        <severity>0</severity>
    </rule>

    <!-- Ignore mixed line-endings warnings -->
    <rule ref="Internal.LineEndings.Mixed">
        <severity>0</severity>
    </rule>

    <!-- Internal exceptions (often occur on minified files) -->
    <rule ref="Internal.Tokenizer.Exception">
        <severity>0</severity>
    </rule>

    <rule ref="WordPress-Docs">
        <!-- Don't worry about page comment blocks -->
        <exclude name="Squiz.Commenting.FileComment.Missing"/>

        <!-- Don't worry about capitalizing long lines -->
        <exclude name="Generic.Commenting.DocComment.LongNotCapital"/>
    </rule>

    <rule ref="WordPress-Extra">
        <!-- Forget about file names -->
        <exclude name="WordPress.Files.FileName"/>

        <!--
            Our hooks are named "newfold/[context]/[action|filter]/[name]", which this
            sniff reads as an uppercase, unseparated hook name. Newfold.NamingConventions.ValidHookName
            enforces our convention instead.
        -->
        <exclude name="WordPress.NamingConventions.ValidHookName"/>

        <!-- Allow same line control structures e.g. if ( true ) { echo 1; } -->
        <exclude name="Squiz.ControlStructures.ControlSignature.NewlineAfterOpenBrace"/>

        <!-- Don't require punctuation after inline comments -->
        <exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>

        <!-- Allow empty catch statements -->
        <exclude name="Generic.CodeAnalysis.EmptyStatement.DetectedCatch"/>

        <!-- Comment punctuation doesn't matter -->
        <exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
    </rule>

    <!--
        Names that land in the global namespace carry a company prefix. Matching is case
        insensitive, so "nfd_" covers "NFD_" and "newfold" covers "Newfold". Both are four
        characters or more, which the sniff requires, and both are legal PHP identifiers,
        which rules out the "nfd-" kebab form used for asset handles.

        A product should add its own prefix on top of these in its ruleset, so that
        searching for it finds everything the product owns.
    -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <!--
            A warning, on the same basis as the two custom naming sniffs: an unprefixed
            global still runs, and it collides only if something else claims the same
            name. Some of them cannot be renamed at all, since a module that re-fires a
            WordPress hook has to fire it under the name core gave it.
        -->
        <type>warning</type>
        <properties>
            <property name="prefixes" type="array">
                <element value="nfd_"/>
                <element value="newfold"/>
            </property>
        </properties>
    </rule>

    <!-- Make missing translator comment a warning. -->
    <rule ref="WordPress.WP.I18n.MissingTranslatorsComment">
        <type>warning</type>
    </rule>

    <!-- Sometimes we need to override globals -->
    <rule ref="WordPress.WP.GlobalVariablesOverride.OverrideProhibited">
        <type>warning</type>
    </rule>

    <!-- Loads the PHP Compatibility ruleset. -->
    <rule ref="PHPCompatibilityWP"/>

    <!-- Throws Warnings for TODO comments in PHP and JS -->
    <rule ref="Generic.Commenting.Todo"/>
    <rule ref="Generic.Commenting.Todo.CommentFound">
        <message>Please review this TODO comment: %s</message>
        <severity>3</severity>
    </rule>

    <!-- Custom Newfold sniff to detect invalid "::class::" usage in PHP versions below 8 -->
    <rule ref="Newfold.PHP.ForbiddenDoubleColonClass"/>

    <!-- Custom Newfold sniff to detect PHP 8 union type syntax (e.g. array|\WP_Error) when targeting PHP 7 -->
    <rule ref="Newfold.PHP.ForbiddenUnionType"/>

    <!--
        Custom Newfold sniff for the "newfold/[context]/[action|filter]/[name]" hook
        convention. Reported as a warning: a hook named against the convention still
        runs, and this standard reserves errors for code that does not parse.
    -->
    <rule ref="Newfold.NamingConventions.ValidHookName">
        <type>warning</type>
    </rule>

    <!--
        Custom Newfold sniff for the "NewfoldLabs\WP\{Plugin|Theme|Module}\{Name}"
        namespace convention. Reported as a warning: a namespace against the
        convention still loads, and this standard reserves errors for code that does
        not parse.
    -->
    <rule ref="Newfold.PHP.NamespaceDeclaration">
        <type>warning</type>
    </rule>

</ruleset>
